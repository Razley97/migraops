# ═══ MigraOps v5.0 — Environment Variables ═══

# REQUIRED — Anthropic API Key
ANTHROPIC_API_KEY=your-anthropic-key-here

# OPTIONAL — DeepSeek API Key (for DeepSeek models)
DEEPSEEK_API_KEY=your-deepseek-key-here

# OPTIONAL — Google Gemini API Key (FREE — https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-key-here

# OPTIONAL — Groq API Key (FREE — https://console.groq.com/keys)
GROQ_API_KEY=your-groq-key-here

# OPTIONAL — GitHub Personal Access Token (for repo imports)
GITHUB_TOKEN=your-github-token-here

# OPTIONAL — Server config
PORT=3001
FRONTEND_URL=http://localhost:5173

# OPTIONAL — Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# OPTIONAL — Logging
LOG_LEVEL=info
