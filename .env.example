# ═══ MigraOps v5.0 — Environment Variables ═══

# REQUIRED — Anthropic API Key
ANTHROPIC_API_KEY=sk-ant-api03-xxxxx

# OPTIONAL — DeepSeek API Key (for DeepSeek models)
DEEPSEEK_API_KEY=sk-xxxxx

# OPTIONAL — Google Gemini API Key (FREE — https://aistudio.google.com/apikey)
GEMINI_API_KEY=AIza-xxxxx

# OPTIONAL — Groq API Key (FREE — https://console.groq.com/keys)
GROQ_API_KEY=gsk_xxxxx

# OPTIONAL — GitHub Personal Access Token (for repo imports)
GITHUB_TOKEN=ghp_xxxxx

# OPTIONAL — Server config
PORT=3001
FRONTEND_URL=http://localhost:5173

# OPTIONAL — Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
